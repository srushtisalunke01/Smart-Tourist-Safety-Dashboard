datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("TOURIST")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  touristProfile    Tourist?
  policeProfile     PoliceOfficer?
  hospitalProfile   Hospital?
  rescueProfile     RescueTeam?
  emergencyContacts EmergencyContact[]
  liveLocations     LiveLocation[]
  sosRequests       SOSRequest[]       @relation("UserSOSRequests")
  resolvedSOS       SOSRequest[]       @relation("ResolvedSOSRequests")
  incidentReports   IncidentReport[]
  notifications     Notification[]
  auditLogs         AuditLog[]
}

model Tourist {
  id             String          @id @default(uuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  passportNumber String?
  nationality    String?
  trips          TouristTrip[]
  blockchainID   BlockchainID?
  devices        TouristDevice[]
}

model PoliceOfficer {
  id                 String @id @default(uuid())
  userId             String @unique
  user               User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeNumber        String
  stationName        String
  lat                Float?
  lng                Float?
  availabilityStatus String @default("Available")
}

model Hospital {
  id                 String @id @default(uuid())
  userId             String @unique
  user               User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalName       String
  address            String
  contactNumber      String
  lat                Float
  lng                Float
  availabilityStatus String @default("Available")
}

model RescueTeam {
  id         String @id @default(uuid())
  userId     String @unique
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamName   String
  specialty  String
  currentLat Float?
  currentLng Float?
  status     String @default("Available")
}

model EmergencyContact {
  id           String  @id @default(uuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  relationship String?
}

model TouristTrip {
  id              String   @id @default(uuid())
  touristId       String
  tourist         Tourist  @relation(fields: [touristId], references: [id], onDelete: Cascade)
  destination     String
  budget          Float
  days            Int
  interests       String // Stored as comma-separated or JSON string in SQLite
  travelStyle     String
  groupType       String
  transportation  String
  itinerary       String // JSON string in SQLite
  budgetBreakdown String // JSON string in SQLite
  carbonFootprint String?
  createdAt       DateTime @default(now())
}

model LiveLocation {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lat          Float
  lng          Float
  speed        Float?
  bearing      Float?
  batteryLevel Int?
  status       String   @default("Safe")
  timestamp    DateTime @default(now())
}

model SOSRequest {
  id           String        @id @default(uuid())
  userId       String
  user         User          @relation("UserSOSRequests", fields: [userId], references: [id], onDelete: Cascade)
  lat          Float
  lng          Float
  status       String        @default("active")
  createdAt    DateTime      @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?         @relation("ResolvedSOSRequests", fields: [resolvedById], references: [id], onDelete: SetNull)
  dispatches   DispatchLog[]
}

model IncidentReport {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         String
  description      String
  address          String
  lat              Float
  lng              Float
  imageUrl         String?
  videoUrl         String?
  status           String   @default("Reported")
  severity         String   @default("medium")
  blockchainTxHash String?
  createdAt        DateTime @default(now())
}

model AIRiskPrediction {
  id           String   @id @default(uuid())
  lat          Float
  lng          Float
  radius       Float
  safetyScore  Float
  crimeIndex   String
  crowdDensity String
  weatherCode  String
  timeOfDay    String
  riskLevel    String
  advisory     String
  createdAt    DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("System")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Language {
  id        String  @id @default(uuid())
  code      String  @unique
  name      String
  isDefault Boolean @default(false)
}

model BlockchainID {
  id              String   @id @default(uuid())
  touristId       String   @unique
  tourist         Tourist  @relation(fields: [touristId], references: [id], onDelete: Cascade)
  userHash        String
  blockNumber     Int
  verifiedAt      DateTime @default(now())
  transactionHash String
}

model TouristDevice {
  id          String   @id @default(uuid())
  touristId   String
  tourist     Tourist  @relation(fields: [touristId], references: [id], onDelete: Cascade)
  deviceToken String
  deviceType  String?
  osVersion   String?
  appVersion  String?
  createdAt   DateTime @default(now())
}

model WeatherAlert {
  id        String   @id @default(uuid())
  title     String
  message   String
  severity  String   @default("warning")
  category  String   @default("Weather")
  lat       Float
  lng       Float
  radius    Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SafeZone {
  id           String   @id @default(uuid())
  name         String
  lat          Float
  lng          Float
  radius       Float
  safetyScore  Float
  crimeIndex   String
  crowdDensity String
  advisory     String
  riskLevel    String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model ResponseTeam {
  id         String        @id @default(uuid())
  type       String
  name       String
  status     String        @default("Available")
  currentLat Float
  currentLng Float
  dispatches DispatchLog[]
}

model DispatchLog {
  id           String       @id @default(uuid())
  sosRequestId String
  sosRequest   SOSRequest   @relation(fields: [sosRequestId], references: [id], onDelete: Cascade)
  teamId       String
  team         ResponseTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  status       String       @default("Dispatched")
  dispatchedAt DateTime     @default(now())
  arrivedAt    DateTime?
  completedAt  DateTime?
  remarks      String?
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  details   String
  ipAddress String?
  timestamp DateTime @default(now())
}

model Attraction {
  id          String   @id @default(uuid())
  name        String
  description String
  location    String
  lat         Float
  lng         Float
  category    String
  ecoScore    Int      @default(0)
  qrCodeToken String   @unique
  createdAt   DateTime @default(now())
}
